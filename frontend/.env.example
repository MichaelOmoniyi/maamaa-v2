# Set these in your local frontend/.env and deployment provider environment.
# Use the project's public URL and publishable/anon key only. Never put a
# Supabase service-role key in the Nuxt frontend.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable-or-anon-key>
# Private server-only Google Gemini key. Never prefix with NUXT_PUBLIC_.
NUXT_GEMINI_API_KEY=<server-only-gemini-api-key>
# Defaults to gemini-3.5-flash-lite if omitted; choose a model enabled for your project.
NUXT_GEMINI_MODEL=gemini-3.5-flash-lite
